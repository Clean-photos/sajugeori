# Auth
AUTH_SECRET=generate-with-npx-auth-secret
NEXTAUTH_URL=http://localhost:3000

# OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM - openai | anthropic
LLM_PROVIDER=openai
LLM_FREE_MODEL=gpt-4o-mini
LLM_PREMIUM_MODEL=gpt-4o
LLM_CHAT_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Toss Payments
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# "true"가 아니면 결제 버튼을 눌러도 실결제창 대신 "준비 중" 안내만 노출된다.
# 카드사 심사 통과 후 실결제를 열 때 "true"로 바꾸고 재배포.
NEXT_PUBLIC_PAYMENTS_ENABLED=

# GA4
NEXT_PUBLIC_GA4_ID=

# Kakao AdFit — 320x100 홈 배너
NEXT_PUBLIC_ADFIT_UNIT_HOME_BANNER=

# Kakao AdFit — 300x250 무료 리포트 광고 게이트 (4종)
NEXT_PUBLIC_ADFIT_UNIT_FREE_SAJU=
NEXT_PUBLIC_ADFIT_UNIT_FREE_COMPATIBILITY=
NEXT_PUBLIC_ADFIT_UNIT_FREE_TAEKIL=
NEXT_PUBLIC_ADFIT_UNIT_FREE_YEARLY=
